flowchart LR
  subgraph clients["Clients"]
    direction TB
    cc["Claude Code<br/>opencode · crush"]
    codex["Codex CLI"]
    gcli["Antigravity CLI<br/>gemini-cli"]
  end

  subgraph gateway["claudication"]
    direction TB
    msg["/v1/messages<br/><i>Anthropic Messages</i>"]
    resp["/v1/responses<br/><i>OpenAI Responses</i>"]
    gem["/v1beta/models<br/><i>Gemini API</i>"]
    route{{"key · client · model name<br/>→ real model → provider"}}
    tr["translate<br/>where the APIs differ"]
    pool[("account pool<br/>priority · quota · cooldowns")]
    relay["relay<br/>retries · streaming · usage"]
    msg --> route
    resp --> route
    gem --> route
    route --> tr --> relay
    pool -. lease .-> relay
  end

  subgraph upstreams["Your subscriptions"]
    direction TB
    claude["Claude<br/>api.anthropic.com"]
    chatgpt["ChatGPT<br/>Codex backend"]
    google["Gemini<br/>Code Assist, as Antigravity"]
  end

  cc --> msg
  codex --> resp
  gcli --> gem
  relay --> claude
  relay --> chatgpt
  relay --> google

  classDef client fill:#f6efe9,stroke:#b4553d,color:#2b211c
  classDef surface fill:#fff8f3,stroke:#e2876a,color:#2b211c
  classDef core fill:#e2876a,stroke:#b4553d,color:#fff8f3
  classDef up fill:#2b211c,stroke:#2b211c,color:#f4ece6
  class cc,codex,gcli client
  class msg,resp,gem surface
  class route,tr,pool,relay core
  class claude,chatgpt,google up
  style clients fill:#fbf7f4,stroke:#e8ddd5,color:#7a6a62
