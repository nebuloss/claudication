%% Which client API reaches which upstream, and how:
%%   thick   as it came (Gemini: rewrapped in Code Assist's envelope)
%%   plain   translated
%%   dotted  through Messages (api.Chain)
%% Rendered to routing.svg by res/images/render.sh.
%%{init: {'theme': 'base', 'themeVariables': {'fontFamily': 'Helvetica, Arial, sans-serif', 'primaryColor': '#fff8f3', 'primaryBorderColor': '#e2876a', 'primaryTextColor': '#2b211c', 'lineColor': '#7a6a62', 'secondaryColor': '#fbf7f4', 'tertiaryColor': '#fbf7f4', 'actorBkg': '#fff8f3', 'actorBorder': '#e2876a', 'actorTextColor': '#2b211c', 'actorLineColor': '#e8ddd5', 'signalColor': '#2b211c', 'signalTextColor': '#2b211c', 'labelBoxBkgColor': '#fdf4ee', 'labelBoxBorderColor': '#e2876a', 'labelTextColor': '#b4553d', 'loopTextColor': '#7a6a62', 'noteBkgColor': '#fdf4ee', 'sequenceNumberColor': '#fff8f3', 'edgeLabelBackground': '#ffffff'}}}%%
flowchart LR
  subgraph apis["Client APIs"]
    direction TB
    M["Anthropic Messages"]
    R["OpenAI Responses"]
    G["Gemini API"]
  end
  subgraph ups["Upstreams"]
    direction TB
    C["Claude"]
    O["ChatGPT"]
    Q["Gemini"]
  end

  M ==> C
  R ==> O
  G ==> Q
  M --> O
  M --> Q
  R --> C
  G --> C
  R -.-> Q
  G -.-> O

  classDef api fill:#fff8f3,stroke:#e2876a,color:#2b211c
  classDef up fill:#2b211c,stroke:#2b211c,color:#f4ece6
  class M,R,G api
  class C,O,Q up
  style apis fill:#fbf7f4,stroke:#e8ddd5,color:#7a6a62
  style ups fill:#fbf7f4,stroke:#e8ddd5,color:#7a6a62
