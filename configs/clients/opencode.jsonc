{
  // opencode, pointed at a claudication gateway.
  // Copy to ~/.config/opencode/opencode.jsonc and change baseURL.
  //
  // WITH /v1. This overrides opencode's built-in OpenAI provider, which sends
  // every model over the Responses API — so each of the names below can serve
  // a Claude model or a GPT one, chosen on the client's page in the gateway.
  // On the Anthropic Messages API instead, the provider is "anthropic" and the
  // names carry "claude" (opencode streams tool calls only for such ids).
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://claudication.example.com/v1",
        "apiKey": "clc_..."
      },
      // This client's model names. opencode knows neither, so each is
      // declared with the limits of the model it serves: an undeclared limit
      // is 0, which turns auto-compaction off.
      "models": {
        "large": {
          "name": "large",
          "limit": { "context": 1000000, "output": 128000 },
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "temperature": false,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "small": {
          "name": "small",
          "limit": { "context": 1000000, "output": 128000 },
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "temperature": false,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        }
      }
    }
  },
  "model": "openai/large",
  "small_model": "openai/small"
}
