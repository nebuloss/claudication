[Unit]
Description=claudication - Claude API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/claudication serve -config /etc/claudication/config.yaml
Restart=on-failure
RestartSec=2s

# The main process is the gateway's own supervisor, which holds the sockets
# and outlives every worker (internal/handover, docs/deploying.md). Reload
# starts a worker from the binary on disk beside the running one, which lets
# go only once the new one serves: an upgrade is a binary swap and a
# `systemctl reload`, and refuses no connection. `restart` is still a stop.
ExecReload=/bin/kill -HUP $MAINPID
# A stop goes to the supervisor alone, which lets go of the sockets and then
# stops its workers; the whole group is killed only at the timeout.
KillMode=mixed

# SIGTERM is the default KillSignal; claudication drains in-flight streams within its
# configured grace period, so give systemd more patience than that grace.
KillSignal=SIGTERM
TimeoutStopSec=150s

# A ceiling the Go runtime knows about, and one the kernel enforces.
#
# GOMEMLIMIT is the important half: without it the garbage collector paces
# itself against a heap that can grow to whatever is available, so on a small
# box the first thing that happens under load is the OOM killer rather than a
# collection. MemoryMax is the backstop for when the runtime is wrong.
# Both are generous for this workload — steady state is tens of megabytes —
# and exist so a burst degrades into GC pressure instead of a killed process.
# MemoryMax is the whole unit's: for the length of a handover's drain two
# workers count against it, which tens of megabytes each leaves room for.
Environment=GOMEMLIMIT=384MiB
MemoryMax=512M
MemoryAccounting=yes

User=claudication
Group=claudication
StateDirectory=claudication
Environment=CLAUDICATION_STATE_DIR=/var/lib/claudication

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
